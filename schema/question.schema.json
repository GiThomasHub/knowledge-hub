{
  "type": "object",
  "required": [
    "id",
    "topic",
    "competencies",
    "level",
    "type",
    "question",
    "explanation",
    "source",
    "status",
    "created",
    "last_verified",
    "author"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "level": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "type": {
      "enum": [
        "single",
        "multi",
        "true_false",
        "order",
        "scenario",
        "case"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "situation": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "answer": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 20
    },
    "model_answer": {
      "type": "string"
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+(#[a-z0-9-]+)?$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "retired"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "question"
}