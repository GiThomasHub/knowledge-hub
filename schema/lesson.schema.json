{
  "type": "object",
  "required": [
    "title",
    "level",
    "competencies",
    "summary",
    "last_verified",
    "sources"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "level": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "volatility": {
      "enum": [
        "hoch",
        "mittel",
        "tief"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_context": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson"
}